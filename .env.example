## Copy this file to .env.local and fill in the secrets.
## .env and .env.local are gitignored — never commit real keys.
## Values prefixed NEXT_PUBLIC_ are bundled into the browser build, so keep
## secrets out of them.

## Version
NEXT_PUBLIC_VERSION=v1.0.0

## Public URL — both blank means the app is served from the domain root
NEXT_PUBLIC_PATH=
NEXT_PUBLIC_BASE_NAME=

## SEO — absolute base for canonical URLs, sitemap.xml and robots.txt
NEXT_PUBLIC_METADATA_BASE=https://rothibouw.nl

## Google Analytics — measurement ID (G-XXXXXXXXXX); leave blank to disable
NEXT_PUBLIC_ANALYTICS_ID=

## Mailerlite — currently unused by the app
MAILERLITE_API_KEY=
MAILERLITE_API_ENDPOINT=
## Use commas to separate multiple groups (Notify all groups)
MAILERLITE_GROUP=

## Resend — required for the contact form (/api/contact) and the job
## application form (/api/apply). Create a key at resend.com/api-keys.
RESEND_API_KEY=
